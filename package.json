{
  "name": "devtalk-presenter",
  "private": true,
  "version": "0.1.0",
  "description": "Animated, interactive browser presentations written as code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
